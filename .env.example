PORT=3000
JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=development
STARTING_BALANCE=10000

# Public base URL used to build links in emails (verification, etc.)
APP_BASE_URL=http://localhost:3000

# --- Email (optional) ---
# If left blank, verification emails are logged to the server console instead
# of actually sent — the flow still works end-to-end for local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VertexFX Demo <no-reply@vertexfx.demo>

# --- Live market data (optional) ---
# Crypto (CoinGecko), forex (Frankfurter), and metals/indices (Stooq/Yahoo) are all
# free and need no key — every instrument gets a real starting price by default.
# Set this to use Twelve Data instead for metals/indices, which is more
# reliable but requires free signup (https://twelvedata.com, rate-limited).
TWELVE_DATA_API_KEY=

# KWD/SAR/IQD vs USDT use open.er-api.com by default (free, no key, no quota) —
# nothing to configure. CURRENCYFREAKS_API_KEY is OPTIONAL, only used as a
# fallback if open.er-api.com is ever unreachable, and is internally capped to
# one real request/hour so it can't blow through a free-tier monthly quota
# again (get a free key at https://currencyfreaks.com if you want this).
CURRENCYFREAKS_API_KEY=

# Optional: how often the CurrencyFreaks fallback is allowed to make a real
# network call, in ms. Default 3600000 (1 hour).
CURRENCYFREAKS_MIN_INTERVAL_MS=
