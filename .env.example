PORT=3000
JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=development
STARTING_BALANCE=10000

# Public base URL used to build links in emails (verification, etc.)
APP_BASE_URL=http://localhost:3000

# --- Email (optional) ---
# If left blank, verification emails are logged to the server console instead
# of actually sent — the flow still works end-to-end for local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VertexFX Demo <no-reply@vertexfx.demo>

# --- Live market data (optional) ---
# Crypto (CoinGecko), forex (Frankfurter), and metals/indices (Stooq/Yahoo) are all
# free and need no key — every instrument gets a real starting price by default.
# Set this to use Twelve Data instead for metals/indices, which is more
# reliable but requires free signup (https://twelvedata.com, rate-limited).
TWELVE_DATA_API_KEY=

# KWD/USDT needs a free CurrencyFreaks API key (https://currencyfreaks.com — free
# tier signup, no card required). Without it, KWD/USDT stays fully simulated.
CURRENCYFREAKS_API_KEY=
