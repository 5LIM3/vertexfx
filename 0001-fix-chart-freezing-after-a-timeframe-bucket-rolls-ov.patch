From f29964e056593d1980f1962416389230b2482651 Mon Sep 17 00:00:00 2001
From: 5LIM3 <alozieanyatonwu@gmail.com>
Date: Tue, 25 Aug 2026 07:04:43 +0000
Subject: [PATCH] fix: chart freezing after a timeframe bucket rolls over
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

updateLiveCandle() only ever mutated candleData's existing last bar.
Once live ticks crossed into a new timeframe bucket (e.g. the current
hour ended on the 1h chart), every subsequent tick kept rewriting that
same stale bar in place instead of opening a new one — nothing on the
chart ever advanced again until the user manually reselected the
symbol or timeframe (the only two places that called loadCandles()).

- updateLiveCandle() now detects the bucket rollover itself and opens
  a fresh bar, mirroring the server's own tick() logic in engine.js.
- Added a 60s periodic loadCandles() resync as a safety net against
  any single dropped WebSocket message.
---
 public/dashboard.html | 26 ++++++++++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/public/dashboard.html b/public/dashboard.html
index fd027b5..7503c0e 100644
--- a/public/dashboard.html
+++ b/public/dashboard.html
@@ -722,6 +722,9 @@ function renderTape(trades){
 }
 
 /* ================= WEBSOCKET LIVE FEED ================= */
+// Bucket size (ms) per timeframe — mirrors server/engine.js TF_SECONDS. Needed
+// so the frontend can tell when the live tick has crossed into a new candle.
+const TF_MS = { '1m': 60000, '5m': 300000, '15m': 900000, '1h': 3600000, '4h': 14400000, '1d': 86400000 };
 function setConnStatus(state){
   // state: 'live' | 'down' | 'connecting'
   const el = document.getElementById('connStatus');
@@ -750,8 +753,24 @@ function connectWs(){
 }
 function updateLiveCandle(){
   const s = snapshot[selSym]; if(!s || !candleData.length || !candleSeries) return;
-  const last = candleData[candleData.length-1];
-  last.h = Math.max(last.h, s.price); last.l = Math.min(last.l, s.price); last.c = s.price;
+  // ROOT CAUSE of "chart stops moving": this only ever mutated candleData's
+  // existing last bar. Once the live price ticked past that bar's timeframe
+  // bucket (e.g. the current hour ended on a 1h chart), every subsequent tick
+  // kept rewriting that same old bar in place — nothing ever advanced, so the
+  // chart visually froze until the user manually reselected the symbol/timeframe
+  // (the only two places that called loadCandles()). Fixed by detecting the
+  // bucket rollover here and opening a new bar, exactly like the server's own
+  // tick() does in engine.js.
+  const bucketMs = TF_MS[currentTf] || 3600000;
+  const bucketStart = Math.floor(Date.now() / bucketMs) * bucketMs;
+  let last = candleData[candleData.length - 1];
+  if (last.t !== bucketStart) {
+    last = { t: bucketStart, o: s.price, h: s.price, l: s.price, c: s.price, v: 0 };
+    candleData.push(last);
+    if (candleData.length > 2000) candleData.shift();
+  } else {
+    last.h = Math.max(last.h, s.price); last.l = Math.min(last.l, s.price); last.c = s.price;
+  }
   candleSeries.update({ time: Math.floor(last.t / 1000), open: last.o, high: last.h, low: last.l, close: last.c });
   // Tick-volume for the still-forming bar: count this tick locally (the server's
   // authoritative per-second volume for this bar lands next time loadCandles() refetches).
@@ -823,6 +842,9 @@ async function init(){
   setInterval(tickClock, 1000);
   setInterval(refreshWallet, 1000);
   setInterval(refreshPositions, 4000);
+  // Resync candles from the server periodically — belt-and-suspenders alongside
+  // the bucket-rollover fix above, in case a WS message is ever dropped.
+  setInterval(loadCandles, 60000);
 }
 (()=>{
   const toggle = document.getElementById('navToggleDb');
